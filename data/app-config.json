{
  "dataset": "data/complete_data.json",
  "datasetLabel": "data/complete_data.json",
  "autoCheck": true,
  "ruleTemplates": [
    {
      "label": { "en": "Women: at most 1 per basic visit", "ar": "السيدات: واحدة على الأكثر لكل زيارة أساسية" },
      "rule": { "rel": "team", "sense": "prefer", "what": { "k": "cat", "v": "basic" }, "op": "max", "n": 1, "who": { "k": "gender", "v": "f" }, "w": 50 }
    },
    {
      "label": { "en": "Women never go alone: none or at least 2 per visit", "ar": "السيدات لا يذهبن منفردات: لا أحد أو اثنتان على الأقل" },
      "rule": { "rel": "team", "sense": "prefer", "what": { "k": "all", "v": "" }, "op": "ifany", "n": 2, "who": { "k": "gender", "v": "f" }, "w": 50 }
    },
    {
      "label": { "en": "Women never go to far places (≥ 70 km)", "ar": "السيدات لا يذهبن للأماكن البعيدة (≥ 70 كم)" },
      "rule": { "rel": "site", "sense": "never", "who": { "k": "gender", "v": "f" }, "what": { "k": "kmGe", "v": "70" }, "w": 50 }
    },
    {
      "label": { "en": "Women prefer places within 30 km", "ar": "السيدات يفضّلن الأماكن في حدود 30 كم" },
      "rule": { "rel": "site", "sense": "prefer", "who": { "k": "gender", "v": "f" }, "what": { "k": "kmLe", "v": "30" }, "w": 40 }
    },
    {
      "label": { "en": "Critical places: everyone except rank ≥ 75 avoids them", "ar": "الأماكن الحرجة: يتجنبها الجميع ما عدا تصنيف ≥ 75" },
      "rule": { "rel": "site", "sense": "avoid", "who": { "k": "rankGe", "v": "75", "not": true }, "what": { "k": "critGe", "v": "100" }, "w": 45 }
    },
    {
      "label": { "en": "Someone: at least 2 contracted visits per plan", "ar": "شخص: زيارتان متعاقدتان على الأقل لكل خطة" },
      "rule": { "rel": "count", "sense": "prefer", "who": { "k": "person", "v": "" }, "op": "min", "n": 2, "what": { "k": "cat", "v": "contracted" }, "per": "plan", "w": 50 }
    },
    {
      "label": { "en": "Someone: at most 1 far visit (≥ 50 km) per week", "ar": "شخص: زيارة بعيدة واحدة على الأكثر (≥ 50 كم) أسبوعياً" },
      "rule": { "rel": "count", "sense": "prefer", "who": { "k": "person", "v": "" }, "op": "max", "n": 1, "what": { "k": "kmGe", "v": "50" }, "per": "week", "w": 50 }
    },
    {
      "label": { "en": "Someone goes anywhere except a location", "ar": "شخص يذهب لأي مكان ما عدا موقع" },
      "rule": { "rel": "site", "sense": "only", "who": { "k": "person", "v": "" }, "what": { "k": "loc", "v": "", "not": true }, "w": 50 }
    },
    {
      "label": { "en": "Critical places: at least 1 rank ≥ 75", "ar": "الأماكن الحرجة: عضو تصنيفه ≥ 75 على الأقل" },
      "rule": { "rel": "team", "sense": "only", "what": { "k": "critGe", "v": "100" }, "op": "min", "n": 1, "who": { "k": "rankGe", "v": "75" }, "w": 60 }
    },
    {
      "label": { "en": "Avoid far places (≥ 70 km)", "ar": "تجنّب الأماكن البعيدة (≥ 70 كم)" },
      "rule": { "rel": "site", "sense": "avoid", "who": { "k": "all", "v": "" }, "what": { "k": "kmGe", "v": "70" }, "w": 40 }
    },
    {
      "label": { "en": "Someone never goes to a location", "ar": "شخص لا يذهب أبداً إلى موقع" },
      "rule": { "rel": "site", "sense": "never", "who": { "k": "person", "v": "" }, "what": { "k": "loc", "v": "" }, "w": 50 }
    },
    {
      "label": { "en": "Someone prefers a category", "ar": "شخص يفضّل فئة" },
      "rule": { "rel": "site", "sense": "prefer", "who": { "k": "person", "v": "" }, "what": { "k": "cat", "v": "contracted" }, "w": 50 }
    },
    {
      "label": { "en": "Nobody works on a weekday", "ar": "لا أحد يعمل يوماً معيّناً" },
      "rule": { "rel": "day", "sense": "never", "who": { "k": "all", "v": "" }, "what": { "k": "dow", "v": [false, false, false, false, false, true, false] }, "w": 50 }
    },
    {
      "label": { "en": "Two juniors avoid pairing", "ar": "مبتدئان لا يعملان معاً" },
      "rule": { "rel": "with", "sense": "avoid", "who": { "k": "rankLe", "v": "25" }, "what": { "k": "rankLe", "v": "25" }, "w": 50 }
    }
  ]
}
